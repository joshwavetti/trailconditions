@page "/"
@using Frontend.Models
@inject HttpClient Http

<h2 class="mb-4">🏔️ Trail Conditions</h2>

@if (trails == null)
{
    <p>Loading trails...</p>
}
else if (trails.Count == 0)
{
    <p>No trails found.</p>
}
else
{
    <div class="row">
        @foreach (var trail in trails)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@trail.Name</h5>
                        <p class="text-muted mb-1">📍 @trail.Region</p>
                        <p class="mb-1">⚡ @trail.Difficulty</p>
                        <p class="mb-1">📏 @trail.LengthKm km</p>
                        <p class="mb-3">⛰️ @trail.ElevationGainM m gain</p>
                        <a href="/trail/@trail.Id" class="btn btn-success btn-sm">View Conditions</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Trail>? trails;

    protected override async Task OnInitializedAsync()
    {
        trails = await Http.GetFromJsonAsync<List<Trail>>("/trails");
    }
}