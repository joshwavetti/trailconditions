@page "/trail/{Id:guid}"
@using Frontend.Models
@inject HttpClient Http

@if (trail == null)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-4">
        <a href="/" class="btn btn-outline-secondary btn-sm mb-3">← Back</a>
        <h2>@trail.Name</h2>
        <p class="text-muted">
            📍 @trail.Region &nbsp;|&nbsp;
            ⚡ @trail.Difficulty &nbsp;|&nbsp;
            📏 @trail.LengthKm km &nbsp;|&nbsp;
            ⛰️ @trail.ElevationGainM m gain
        </p>
        @if (!string.IsNullOrEmpty(trail.ExternalUrl))
        {
            <a href="@trail.ExternalUrl" target="_blank" class="btn btn-outline-success btn-sm mb-4">
                View on Komoot
            </a>
        }
    </div>

    <div class="row">
        <div class="col-md-7">
            <h4 class="mb-3">📋 Condition Reports</h4>
            @if (trail.Reports.Count == 0)
            {
                <p class="text-muted">No reports yet. Be the first to report!</p>
            }
            else
            {
                @foreach (var report in trail.Reports.OrderByDescending(r => r.ReportedAt))
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge @GetConditionBadge(report.OverallCondition) fs-6">
                                    @GetConditionEmoji(report.OverallCondition) @report.OverallCondition
                                </span>
                                <small class="text-muted">@report.ReportedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                            </div>
                            @if (report.Tags.Any())
                            {
                                <div class="mb-2">
                                    @foreach (var tag in report.Tags)
                                    {
                                        <span class="badge bg-secondary me-1">@tag.Tag</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(report.Notes))
                            {
                                <p class="mb-1">@report.Notes</p>
                            }
                            <small class="text-muted">Reported by @report.ReportedBy</small>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="col-md-5">
            <h4 class="mb-3">📝 Submit a Report</h4>
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Overall Condition</label>
                        <select class="form-select" @bind="newReport.OverallCondition">
                            <option value="">-- Select --</option>
                            <option value="Good">✅ Good</option>
                            <option value="Difficult">⚠️ Difficult</option>
                            <option value="Avoid">❌ Avoid</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tags</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in availableTags)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="tag_@tag"
                                           checked="@selectedTags.Contains(tag)" @onchange="() => ToggleTag(tag)" />
                                    <label class="form-check-label" for="tag_@tag">@tag</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" rows="3" @bind="newReport.Notes"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Your Name</label>
                        <input class="form-control" @bind="newReport.ReportedBy" placeholder="Anonymous" />
                    </div>
                    @if (!string.IsNullOrEmpty(submitMessage))
                    {
                        <div class="alert alert-success">@submitMessage</div>
                    }
                    <button class="btn btn-success w-100" @onclick="SubmitReport">Submit Report</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Trail? trail;
    private ConditionReport newReport = new();
    private string submitMessage = string.Empty;
    private List<string> selectedTags = new();
    private List<string> availableTags = new()
    {
        "Perfect", "Muddy", "Icy", "Snowy", "Wet Rocks",
        "Fallen Trees", "Trail Closed", "Crowded"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTrail();
    }

    private async Task LoadTrail()
    {
        trail = await Http.GetFromJsonAsync<Trail>($"/trails/{Id}");
    }

    private void ToggleTag(string tag)
    {
        if (selectedTags.Contains(tag))
            selectedTags.Remove(tag);
        else
            selectedTags.Add(tag);
    }

    private async Task SubmitReport()
    {
        if (string.IsNullOrEmpty(newReport.OverallCondition)) return;

        newReport.Tags = selectedTags.Select(t => new ReportTag { Tag = t }).ToList();

        await Http.PostAsJsonAsync($"/trails/{Id}/reports", newReport);

        submitMessage = "Report submitted! Thank you 🙌";
        newReport = new();
        selectedTags.Clear();
        await LoadTrail();
    }

    private string GetConditionBadge(string condition) => condition switch
    {
        "Good" => "bg-success",
        "Difficult" => "bg-warning text-dark",
        "Avoid" => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetConditionEmoji(string condition) => condition switch
    {
        "Good" => "✅",
        "Difficult" => "⚠️",
        "Avoid" => "❌",
        _ => "❓"
    };
}